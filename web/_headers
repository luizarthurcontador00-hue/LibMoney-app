# Cabeçalhos de resposta. Cloudflare Pages e Netlify leem este mesmo
# arquivo, com o mesmo formato.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Quando o app voltar a ser servido daqui, o bloco abaixo volta junto. Ele
# liga o isolamento entre origens, sem o qual o banco no navegador não abre —
# a página carrega e não mostra dado nenhum, sem erro visível.
#
# /app/*
#   Cross-Origin-Opener-Policy: same-origin
